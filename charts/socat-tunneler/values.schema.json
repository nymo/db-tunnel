{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["dbhost"],
  "properties": {
    "dbhost": {
      "type": "string",
      "minLength": 1,
      "description": "Hostname or IP address of the database to tunnel to"
    },
    "dbport": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "listenPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
